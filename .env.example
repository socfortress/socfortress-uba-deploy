# SOCFortress UBA settings. Copy to .env (chmod 600) and replace every <...> value.
#   <uba-ip>      this VM's address
#   <graylog-ip>  the Graylog server
#   <indexer-ip>  the Wazuh indexer
#   <copilot-ip>  the CoPilot server
# All four are on the same private network (VLAN).

# --- Version ---------------------------------------------------------------------------------------
# A release (https://github.com/socfortress/socfortress-uba-deploy/releases lists them). To upgrade,
# change it to the new version, then: docker compose pull && docker compose up -d
UBA_TAG=1.3.0

# --- Secrets (generate once, keep them) ------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=<generate>
# openssl rand -base64 32 | tr '+/' '-_'
# Encrypts identity-source secrets (e.g. Entra app secrets): a new key means entering them again.
UBA_SECRET_KEY=<generate>

# --- Where UBA listens on this VM ------------------------------------------------------------------
UBA_API_PUBLISH=8010            # CoPilot's connector URL: http://<uba-ip>:8010
UBA_GELF_PUBLISH=12201          # Graylog sends the UBA feed here

# --- What CoPilot's "Set up UBA" creates in Graylog ------------------------------------------------
UBA_PROVISION_FEED_HOST=<uba-ip>        # Graylog's UBA output -> this VM
UBA_PROVISION_FEED_PORT=12201
UBA_PROVISION_ALERTS_BIND=0.0.0.0       # Graylog's "UBA ALERTS" input, on the Graylog server
UBA_GRAYLOG_GELF_HOST=<graylog-ip>      # UBA's alerts -> that input
UBA_GRAYLOG_GELF_PORT=12204

# --- Wazuh indexer: history for new customers, evidence, gap repair ---------------------------------
UBA_INDEXER__URL=https://<indexer-ip>:9200
UBA_INDEXER__USERNAME=admin
UBA_INDEXER__PASSWORD=<indexer admin password>
UBA_INDEXER__VERIFY_CERTS=false
# To verify the indexer's certificate instead: copy its root CA to data/geoip/indexer-root-ca.pem,
# set UBA_INDEXER__VERIFY_CERTS=true and uncomment:
# UBA_INDEXER__CA_CERTS=/var/lib/uba/indexer-root-ca.pem

# --- CoPilot Incident Management: UBA alerts become CoPilot alerts ----------------------------------
# A CoPilot service account with the analyst role and no 2FA.
UBA_COPILOT_URL=http://<copilot-ip>:5000
UBA_COPILOT_USERNAME=<service account>
UBA_COPILOT_PASSWORD=<password>

# --- Detection extras -------------------------------------------------------------------------------
# Computer changes (new local admins, services, listening ports, browser extensions): every 30 minutes.
UBA_INVENTORY_EVERY_S=1800
# Optional MaxMind GeoLite2 files in data/geoip: countries and networks for sign-ins. Without them the
# new-country, new-network and impossible-travel rules stay quiet.
UBA_ENRICH__GEOIP_CITY_DB=/var/lib/uba/GeoLite2-City.mmdb
UBA_ENRICH__GEOIP_ASN_DB=/var/lib/uba/GeoLite2-ASN.mmdb

# --- Customers --------------------------------------------------------------------------------------
# Customers are registered from CoPilot ("Set up UBA" on the User Behavior page), not listed here.
UBA_BOOTSTRAP_TENANTS=[]
UBA_O365_TENANT_MAP={}

UBA_LOG_LEVEL=INFO
